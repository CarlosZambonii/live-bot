# OpenAI — cérebro + visão (teus créditos)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Voicebox — voz + ouvido, local (http://127.0.0.1:17493)
VOICEBOX_URL=http://127.0.0.1:17493
TTS_ENGINE=kokoro                 # CPU agora -> chatterbox-multilingual quando a RTX chegar
TTS_LANGUAGE=pt
STT_MODEL=whisper-base            # base/small na CPU -> turbo na GPU

# Twitch — chat (Fase 0)
TWITCH_CHANNEL=
TWITCH_OAUTH=

LOG_LEVEL=info
